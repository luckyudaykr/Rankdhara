# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAILS: Comma-separated list of admin email addresses (automatically granted admin role and claims)
ADMIN_EMAILS="kuday6631@gmail.com,admin@example.com"

# ADMIN_SECRET: Secret key to authenticate admin endpoints
ADMIN_SECRET="testbook-admin-secret"

# FIREBASE CONFIGURATION (Server-side Firestore & Auth)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="your-service-account-email@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# FIREBASE CLIENT CONFIGURATION (Optional: for client-side Auth SDK)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
